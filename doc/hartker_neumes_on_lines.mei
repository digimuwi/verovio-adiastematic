                  <neume>
                    <nc pname="g" oct="3" tilt="ne" curve="c" />
                    <nc pname="f" oct="3" tilt="s" />
                    <nc pname="g" oct="3" curve="a" tilt="ne" />
                    <nc pname="f" oct="3" curve="c" tilt="s" />
                    <nc pname="g" oct="3" tilt="ne">
                      <liquescent curve="a" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pes rotundus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" curved="a" tilt="se" rellen="s" />
                    <nc pname="g" oct="3" tilt="ne" curve="c">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pes rotundus liquescent episema</syl>
                  <neume>
                    <nc pname="f" oct="3" curve="a" tilt="se" rellen="s" />
                    <nc pname="g" oct="3" tilt="n">
                      <liquescent curve="c" looped="true" />
                      <episema place="above" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pes quadratus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="se" rellen="s" />
                    <nc pname="g" oct="3" tilt="n">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pes quadratus liquescent episema</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="se" />
                    <nc pname="g" oct="3" rellen="l" tilt="n" curve="c">
                      <liquescent curve="c" looped="true" />
                      <episema place="above" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pes quassus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" s-shape="s" tilt="se" rellen="s" />
                    <nc pname="g" oct="3" tilt="ne">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Virga strata liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="ne" s-shape="s" />
                    <nc pname="g" oct="3" tilt="ne" rellen="s">
                      <oriscus />
                      <liquescent looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus liquescent 4</syl>
                  <neume>
                    <nc pname="g" oct="3" curve="a" tilt="se" rellen="s" />
                    <nc pname="a" oct="3" tilt="ne" curve="c" rellen="l" />
                    <nc pname="g" oct="3" tilt="s" />
                    <nc pname="f" oct="3" tilt="se">
                      <liquescent curve="c" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus liquescent episema 4</syl>
                  <neume>
                    <nc pname="g" oct="3" curve="a" tilt="se" rellen="s" />
                    <nc pname="a" oct="3" tilt="ne" rellen="l" curve="c">
                      <episema place="above" />
                    </nc>
                    <nc pname="g" oct="3" tilt="s" />
                    <nc pname="f" oct="3" tilt="se">
                      <liquescent curve="c" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus liquescent 4</syl>
                  <neume>
                    <nc pname="g" oct="3" tilt="se" rellen="s" />
                    <nc pname="a" oct="3" tilt="ne" curve="c" />
                    <nc pname="g" oct="3" tilt="s" />
                    <nc pname="f" oct="3" tilt="se">
                      <liquescent curve="c" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus liquescent episema 4</syl>
                  <neume>
                    <nc pname="g" oct="3" tilt="se" />
                    <nc pname="a" oct="3" curve="c" rellen="l" tilt="ne">
                      <episema place="above" />
                    </nc>
                    <nc pname="g" oct="3" tilt="s" />
                    <nc pname="f" oct="3" tilt="s">
                      <liquescent curve="c" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus resupinus flexus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" curve="a" tilt="se" rellen="s" />
                    <nc pname="g" oct="3" tilt="ne" curve="c" />
                    <nc pname="f" oct="3" tilt="s" />
                    <nc pname="g" oct="3" tilt="ne" rellen="l">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus resupinus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" curve="a" tilt="se" />
                    <nc pname="g" oct="3" tilt="ne" curve="c" rellen="l" />
                    <nc pname="f" oct="3" tilt="s" rellen="s">
                      <liquescent curve="a" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus resupinus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="se" />
                    <nc pname="g" oct="3" rellen="l" tilt="ne" />
                    <nc pname="f" oct="3" tilt="s" rellen="s" curve="c">
                      <liquescent curve="a" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Torculus resupinus liquescent episema</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="e" />
                    <nc pname="g" oct="3" rellen="l" tilt="n" curve="c">
                      <episema form="h" place="left" />
                    </nc>
                    <nc pname="f" oct="3" tilt="e" curve="a">
                      <liquescent curve="a" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Scandicus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="e" />
                    <nc pname="g" oct="3" con="g" tilt="e" />
                    <nc pname="a" oct="3" con="g" tilt="ne" rellen="l">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Salicus liquescent</syl>
                  <neume>
                    <nc pname="f" oct="3" />
                    <nc pname="g" oct="3" con="g" curve="c" tilt="e">
                      <oriscus />
                    </nc>
                    <nc pname="a" oct="3" con="g" tilt="ne">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Looped connection</syl>
                  <neume>
                    <nc pname="f" oct="3" tilt="se" />
                    <nc pname="g" oct="3" con="l" tilt="n" rellen="l" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: pes, a fifth</syl>
                  <neume>
                    <nc pname="d" oct="3" curve="a" tilt="s" />
                    <nc pname="a" oct="3" tilt="ne" rellen="l" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: clivis, a fourth</syl>
                  <neume>
                    <nc pname="c" oct="4" tilt="ne" curve="c" />
                    <nc pname="g" oct="3" tilt="s" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: porrectus, uneven intervals</syl>
                  <neume>
                    <nc pname="c" oct="4" tilt="ne" />
                    <nc pname="f" oct="3" tilt="s" />
                    <nc pname="a" oct="3" tilt="ne" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: torculus, wide</syl>
                  <neume>
                    <nc pname="e" oct="3" tilt="se" />
                    <nc pname="b" oct="3" tilt="ne" />
                    <nc pname="f" oct="3" tilt="s" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: climacus, a third then a step</syl>
                  <neume>
                    <nc pname="c" oct="4" tilt="ne" />
                    <nc pname="a" oct="3" con="g" />
                    <nc pname="g" oct="3" con="g" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: scandicus, a step then a fourth</syl>
                  <neume>
                    <nc pname="d" oct="3" />
                    <nc pname="e" oct="3" con="g" />
                    <nc pname="a" oct="3" con="g" tilt="ne" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: quilisma scandicus, thirds</syl>
                  <neume>
                    <nc pname="d" oct="3" tilt="e" rellen="s" />
                    <nc pname="f" oct="3" con="g">
                      <quilisma waves="3" />
                    </nc>
                    <nc pname="a" oct="3" tilt="ne" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: cephalicus, a fourth</syl>
                  <neume>
                    <nc pname="c" oct="4" tilt="ne" rellen="l" />
                    <nc pname="g" oct="3">
                      <liquescent curve="c" looped="true" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: epiphonus, a fifth</syl>
                  <neume>
                    <nc pname="d" oct="3" tilt="s" curve="a" />
                    <nc pname="a" oct="3" tilt="ne">
                      <liquescent curve="a" />
                    </nc>
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: pressus on one pitch</syl>
                  <neume>
                    <nc pname="a" oct="3" tilt="ne" />
                    <nc pname="a" oct="3" s-shape="n" rellen="s" />
                    <nc pname="g" oct="3" con="g" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Pitched: pes with a repeated first note</syl>
                  <neume>
                    <nc pname="f" oct="3" />
                    <nc pname="f" oct="3" />
                    <nc pname="g" oct="3" tilt="ne" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Conflict: rising tilt on a falling note</syl>
                  <neume>
                    <nc pname="c" oct="4" tilt="ne" curve="c" />
                    <nc pname="a" oct="3" tilt="ne" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Conflict: level stroke over a fifth</syl>
                  <neume>
                    <nc pname="e" oct="3" tilt="e" />
                    <nc pname="b" oct="3" tilt="e" />
                  </neume>
                </syllable>
                <syllable>
                  <syl>Staff: F clef on line 3</syl>
                  <clef shape="F" line="3" />
                  <neume>
                    <nc pname="f" oct="3" curve="a" tilt="s" />
                    <nc pname="a" oct="3" tilt="ne" rellen="l" />
                  </neume>
                </syllable>
              </layer>
            </staff>
          </section>
        </score>
      </mdiv>
    </body>
  </music>
</mei>